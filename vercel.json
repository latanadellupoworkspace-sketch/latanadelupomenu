{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/gestione-tana(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/gestione.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(js|css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/gestione-tana",
      "permanent": false
    },
    {
      "source": "/gestione",
      "destination": "/gestione-tana",
      "permanent": false
    }
  ]
}